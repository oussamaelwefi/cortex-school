{
  "name": "cortex-school-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "contracts": "python scripts/generate_contracts.py",
    "test": "node --import tsx --import ./tests/english-preference.mjs --test tests/*.test.mjs",
    "format": "prettier --write src tests index.html vite.config.ts tsconfig.json package.json README.md"
  },
  "dependencies": {
    "@workos-inc/authkit-react": "^0.16.3",
    "entities": "^9.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
